# PostgreSQL Database
POSTGRES_PASSWORD=changeme

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO Server-Side Encryption (SSE-KMS)
# Format: alias:base64-encoded-256-bit-key
# Generate with: python3 -c "import secrets, base64; print('mykey:' + base64.b64encode(secrets.token_bytes(32)).decode())"
MINIO_KMS_SECRET_KEY=mykey:REPLACE_WITH_BASE64_256BIT_KEY
